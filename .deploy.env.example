# Salin jadi .deploy.env lalu isi. File .deploy.env DIABAIKAN git (aman).
#
#   cp .deploy.env.example .deploy.env
#   # isi token di bawah
#   npm run ship
#
# Semua baris boleh dikosongkan — skrip akan melewati langkah yang tokennya kosong
# dan memberitahu apa yang kurang. Aman dijalankan berulang kali.

# ── WAJIB untuk deploy ────────────────────────────────────────────────────
# https://dash.cloudflare.com/profile/api-tokens
#   Create Token → template "Edit Cloudflare Workers" → Continue → Create
CLOUDFLARE_API_TOKEN=
# Dashboard → Workers & Pages → lihat sidebar kanan "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# ── DATABASE: pilih SALAH SATU ────────────────────────────────────────────
# Opsi A (otomatis): https://console.neon.tech/app/settings/api-keys → Create API key
#   Skrip akan membuat project Neon "ghostfun" sendiri.
NEON_API_KEY=

# Opsi B (manual): kalau sudah punya Postgres sendiri, isi ini dan kosongkan NEON_API_KEY
DATABASE_URL=

# ── OPSIONAL: auto-push ke GitHub ─────────────────────────────────────────
# https://github.com/settings/tokens/new → centang scope "repo" → Generate
GITHUB_TOKEN=
# Nama repo yang dibuat (default: ghostfun)
GITHUB_REPO=ghostfun
