# Copy to .env for local development, and set the same value as a
# Cloudflare secret for production:  npx wrangler secret put DATABASE_URL
#
# Local sandbox example:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production (Neon / Supabase / any managed Postgres). Must be reachable
# over the public internet and use SSL:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Protocol fees (your margin) ────────────────────────────────────────
# Leave TREASURY_ACCOUNT empty to disable all platform fees.
# Set it to your NEAR account to start collecting.
NEXT_PUBLIC_TREASURY_ACCOUNT=
NEXT_PUBLIC_LAUNCH_FEE_NEAR=0.05
NEXT_PUBLIC_SWAP_FEE_BPS=50

# Holder connection analysis: optional server-side key for production history access.
# Get it from https://dashboard.fastnear.com and keep it out of the browser bundle.
# Cloudflare: npx wrangler secret put FASTNEAR_API_KEY
FASTNEAR_API_KEY=
